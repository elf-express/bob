{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@elf-express/bob",
  "version": "1.0.0",
  "description": "BOB Tools — 人 ↔ AI ↔ 命令的中間層:專案結構視覺化、指令執行、依賴掃描、AI 標註/執行審計軌跡(本地 Web UI,host tool)",
  "license": "UNLICENSED",
  "author": "elf-express",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.18"
  },
  "type": "commonjs",
  "main": "src/server.js",
  "bin": {
    "bob": "src/server.js"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "public",
    "data/.gitkeep",
    "README.md",
    "README.zh-tw.md",
    "USAGE.zh-TW.md",
    "skills.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/server.js",
    "bob": "node src/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm pack --dry-run",
    "verify": "pnpm format:check && pnpm lint && pnpm test:coverage && pnpm build",
    "version:show": "node scripts/version.mjs",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "multer": "^2.1.1",
    "sqlite3": "^6.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elf-express/bob.git"
  },
  "bugs": {
    "url": "https://github.com/elf-express/bob/issues"
  },
  "homepage": "https://github.com/elf-express/bob#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "7.3.1",
    "vitest": "5.0.1"
  }
}
